{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^(Bash|apply_patch|Edit|Write)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/hook.mjs\" --tool=codex --event=PreToolUse"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(Bash|apply_patch|Edit|Write)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/hook.mjs\" --tool=codex"
					}
				]
			}
		]
	}
}
