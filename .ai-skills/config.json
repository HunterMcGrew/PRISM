{
	"org": "PRISM",
	"project": "PRISM",
	"ticketPrefix": "PRISM",
	"ticketSystem": {
		"kind": "github-issues"
	},
	"github": {
		"owner": "HunterMcGrew",
		"repo": "PRISM"
	},
	"defaultBranch": "main",
	"hookRuntimeDir": "scripts/ai-skills/hooks",
	"features": {
		"mainSessionMayMerge": true
	},
	"hooks": {
		"commitCleanupPass": true,
		"pushVerification": true
	},
	"testGlobs": ["scripts/ai-skills/*.test.ts", "scripts/ai-skills/**/*.test.ts"],
	"reviewIgnore": [
		".prism/plans/**",
		".prism/lessons.md",
		".prism/retros/**",
		".prism/audits/**",
		".prism/metrics/**",
		".claude/rules/**",
		".claude/architect/**",
		".claude/spec/**",
		".claude/templates/**",
		".claude/references/**",
		".claude/review/**",
		".claude/SPEC.md",
		".codex/rules/**",
		".codex/architect/**",
		".codex/spec/**",
		".codex/templates/**",
		".codex/references/**",
		".codex/review/**",
		".codex/SPEC.md",
		".cursor/rules/**",
		".cursor/architect/**",
		".cursor/spec/**",
		".cursor/templates/**",
		".cursor/references/**",
		".cursor/review/**",
		".cursor/SPEC.md",
		".claude/skills/**",
		".cursor/skills/**",
		".claude/agents/**",
		".codex/agents/**"
	],
	"techStack": ["typescript", "node"],
	"commands": {
		"typecheck": "pnpm run prism:check-types",
		"test": "pnpm run prism:test",
		"lint": "pnpm run prism:crossref-lint",
		"format": "",
		"build": "pnpm run prism:build"
	},
	"rules": {
		"universal": "all"
	},
	"slackChannel": "#prism-dev",
	"documentation": {
		"location": "docs/",
		"audience": "developer-user",
		"keepsDevDocs": false,
		"format": "flat-markdown-guides"
	},
	"retroEvidence": {
		"ci": { "present": true, "system": "github-actions" },
		"prPlatform": "github",
		"testCommand": "pnpm run prism:test",
		"dodGates": ["types", "crossref-lint", "tests", "build"]
	}
}
