{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^(Bash|apply_patch|Edit|Write)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/hook.mjs\" --tool=codex --event=PreToolUse"
					}
				]
			},
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/git-gates.mjs\" --tool=codex --event=PreToolUse"
					}
				]
			},
			{
				"matcher": "^(Bash|apply_patch|Edit|Write)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/approve-guard.mjs\" --tool=codex --event=PreToolUse"
					}
				]
			},
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/secrets-gate.mjs\" --tool=codex --event=PreToolUse",
						"timeout": 21
					}
				]
			},
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/commit-gate.mjs\" --tool=codex --event=PreToolUse",
						"timeout": 21
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/approve-guard.mjs\" --tool=codex --event=UserPromptSubmit"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(Bash|apply_patch|Edit|Write)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/hook.mjs\" --tool=codex"
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/hook.mjs\" --tool=codex --event=SessionStart"
					}
				]
			}
		],
		"PostCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \".claude/hooks/hook.mjs\" --tool=codex --event=PostCompact"
					}
				]
			}
		]
	}
}
