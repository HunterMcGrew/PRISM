{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Write|Edit|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/hook.mjs\" --tool=claude --event=PreToolUse"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/git-gates.mjs\" --tool=claude --event=PreToolUse"
					}
				]
			},
			{
				"matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/approve-guard.mjs\" --tool=claude --event=PreToolUse"
					}
				]
			},
			{
				"matcher": "Read|Grep|Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/secrets-gate.mjs\" --tool=claude --event=PreToolUse",
						"timeout": 21
					}
				]
			},
			{
				"matcher": "Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/commit-gate.mjs\" --tool=claude --event=PreToolUse",
						"timeout": 21
					}
				]
			},
			{
				"matcher": "Agent|Task",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/brief-gate.mjs\" --tool=claude --event=PreToolUse",
						"timeout": 21
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "f=\"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/approve-guard.mjs\"; if [ -f \"$f\" ]; then node \"$f\" --tool=claude --event=UserPromptSubmit; else echo '{\"systemMessage\":\"PRISM approve guard is missing from the checkout this session started in, so chat approvals are not recorded. Pull that checkout, or run approve.mjs from a terminal.\",\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"PRISM approve guard is missing from the checkout this session started in, so chat approvals are not recorded. Tell the person, and ask them to pull that checkout or run approve.mjs from a terminal.\"}}'; fi"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Read|Grep|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/hook.mjs\" --tool=claude"
					}
				]
			}
		],
		"PostCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/hook.mjs\" --tool=claude --event=PostCompact"
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/hook.mjs\" --tool=claude --event=PreCompact"
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|resume|compact",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/hook.mjs\" --tool=claude --event=SessionStart"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": "^prism-pr-review$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-skills/hooks/reconcile-gate.mjs\" --tool=claude --event=SubagentStop",
						"timeout": 120
					}
				]
			}
		]
	}
}
