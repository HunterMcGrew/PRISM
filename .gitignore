.DS_Store
*.swp
node_modules

# PRISM build outputs — committed-vs-ignored split per `.ai-skills/docs/compatibility.md § Per-Tool Directory Ownership`.
# `.agents/` is the per-user Codex skills root — fully ignored.
/.agents/
# `.codex/codex-config.toml` is a per-user file (personality, projects, marketplaces) — committing it would clobber consumer customization.
/.codex/codex-config.toml
# Per-tool worktree state is operational, not generated — ignored on every tool namespace.
.claude/worktrees/
.codex/worktrees/
.cursor/worktrees/
# Per-user local overrides — ignored.
.claude/settings.local.json

# The esbuild bundle is build-time-materialized, not tracked. `prepare` builds it at
# install, `prepack` before any tarball, and `prepublishOnly` before publish; npm
# `files` ships it regardless of this ignore — the same mechanism that already ships
# the gitignored `.prism/.sync-manifest.json`. See ADR-0063 and issue #425: a tracked
# machine-generated bundle with no drift gate is a silent-staleness surface.
/dist/

# Sync manifest — generated by prism:build, carries per-build volatile fields
# (sourceCommit, generatedAt). Regenerated on every build; never a drift target.
.prism/.sync-manifest.json

# Architect-route hook state — operational; one file per session tracking which
# architect docs the PostToolUse(Read) hook has already injected. Gitignored
# as operational state.
.prism/architect-route-state.*.json
.prism/architect-route-state.*.json.tmp
.prism/git-gates-state.*.json
.prism/git-gates-state.*.json.tmp

# npm pack output — regenerated each release; reviewed via /tmp/prism-tarball-contents.txt.
*.tgz

# Legacy Sol run state. Sol is retired, but older checkouts still hold these
# files, and ignoring them keeps a `git add -A` from committing them.
.prism/conductor-state.json
.prism/conductor-state.json.tmp
.prism/conductor-state.*.json
.prism/conductor/
