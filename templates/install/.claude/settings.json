{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Write|Edit|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.mjs\" --tool=claude --event=PreToolUse"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-gates.mjs\" --tool=claude --event=PreToolUse"
					}
				]
			},
			{
				"matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/approve-guard.mjs\" --tool=claude --event=PreToolUse"
					}
				]
			},
			{
				"matcher": "Read|Grep|Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/secrets-gate.mjs\" --tool=claude --event=PreToolUse",
						"timeout": 21
					}
				]
			},
			{
				"matcher": "Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-gate.mjs\" --tool=claude --event=PreToolUse",
						"timeout": 21
					}
				]
			},
			{
				"matcher": "Agent|Task",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/brief-gate.mjs\" --tool=claude --event=PreToolUse",
						"timeout": 21
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/approve-guard.mjs\" --tool=claude --event=UserPromptSubmit"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Read|Grep|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.mjs\" --tool=claude"
					}
				]
			}
		],
		"PostCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.mjs\" --tool=claude --event=PostCompact"
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.mjs\" --tool=claude --event=PreCompact"
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|resume|compact",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.mjs\" --tool=claude --event=SessionStart"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": "^prism-pr-review$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reconcile-gate.mjs\" --tool=claude --event=SubagentStop",
						"timeout": 120
					}
				]
			}
		]
	}
}
